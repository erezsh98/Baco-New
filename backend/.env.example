# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Database ---
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost/play_tennis

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Pelecard (credit-card gateway). Leave blank + DEV_MODE=true to bypass. ---
PELECARD_GATEWAY_URL=https://gateway.pelecard.biz/Iframe
#
# Per-club terminal credentials are matched to a club by its DB u_name, using the
# convention PELECARD_<UNAME>_TERM / PELECARD_<UNAME>_PASSWORD (u_name upper-cased).
# To add a new club, just add its two vars here (or as real env vars) — NO code
# change is needed. Examples:
PELECARD_MATNASIM_TERM=
PELECARD_MATNASIM_PASSWORD=
PELECARD_EVENYHUDA_TERM=
PELECARD_EVENYHUDA_PASSWORD=
PELECARD_KADIMATENNIS_TERM=
PELECARD_KADIMATENNIS_PASSWORD=
PELECARD_SHASHO_TERM=
PELECARD_SHASHO_PASSWORD=
# e.g. a new club whose u_name is "kadimamadaf":
# PELECARD_KADIMAMADAF_TERM=...
# PELECARD_KADIMAMADAF_PASSWORD=...

# ---------------------------------------------------------------------------
# TTLock (smart gate locks). Optional, per-club. A club with no TTLock_<id>_*
# vars simply has no gate code — the booking flow is unchanged for it.
# Enabling a club is env-only (plus migration 005's court_order.gate_code column).
#
# Per club, keyed by the club's DB id (e.g. club 7):
#   TTLOCK_7_LOCK_ID        = the court gate's lockId (npm run cli -- locks, in the POC)
#   TTLOCK_7_USERNAME       = the TTLock *app* account that owns the lock
#   TTLOCK_7_PASSWORD       = that account's password (we md5 it), OR
#   TTLOCK_7_PASSWORD_MD5   = its lowercase md5 (use one or the other)
#   TTLOCK_7_CLIENT_ID      = optional; overrides the global client id below
#   TTLOCK_7_CLIENT_SECRET  = optional; overrides the global client secret
#   TTLOCK_7_EARLY_ENTRY_MIN= optional; overrides the global early-entry below
# Global (shared by all clubs unless overridden per-club):
TTLOCK_API_BASE=https://euapi.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
# Minutes before the slot the PIN starts working. Offline PINs are hour-granular,
# so a non-zero value opens the previous whole hour; set 0 for exact hour windows.
TTLOCK_EARLY_ENTRY_MIN=30
# NOTE: TTLock rejects calls whose clock is >5 min off — keep NTP on the server.

# --- SMS (019sms). Optional; blank = no-op. ---
SMS_USERNAME=
SMS_PASSWORD=
SMS_GATEWAY_URL=https://www.019sms.co.il:8090/api

# ---------------------------------------------------------------------------
# E-MAIL (SMTP) — production uses Mailgun (same as the legacy system).
# Get credentials from Mailgun > Sending > Domains > <domain> > SMTP credentials:
#   SMTP_USER     = postmaster@<your-mailgun-domain>
#   SMTP_PASSWORD = the SMTP password shown for that domain
#   EMAIL_FROM    = the 'from' address (ideally on the verified domain)
# Blank credentials = email no-ops (the rest of the app still works).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=servicebaco@gmail.com

# Alternative — direct Gmail SMTP (needs 2-Step Verification + a 16-char App Password):
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USER=servicebaco@gmail.com / SMTP_PASSWORD=<app-password>
# Alternative — production-style local relay (Postfix -> Mailgun on the server):
#   SMTP_HOST=localhost / SMTP_PORT=25 / SMTP_USER= / SMTP_PASSWORD=

# --- URLs ---
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# --- Misc ---
# Note: the AI chat's ANTHROPIC_API_KEY lives in the FRONTEND (frontend/.env.local),
# not here — the chat runs in the Next.js server route, not the backend.
# DEV_MODE=true bypasses the Pelecard gateway so card bookings auto-confirm.
DEV_MODE=true

# --- Background jobs (rebuild + release_uncompleted_orders) ---
# ENABLE_SCHEDULER=true runs the jobs in-process (APScheduler). Keep true for
# dev / a single always-on server. Set false in GCP when Cloud Scheduler drives
# the /jobs endpoints, so the jobs don't run twice.
ENABLE_SCHEDULER=true
# Shared secret Cloud Scheduler must send as the X-Scheduler-Token header to
# call POST /jobs/rebuild and POST /jobs/release-orders. Blank = /jobs disabled
# (fail closed). Set a long random value in production. See
# docs/Background-Jobs-Deployment.md.
SCHEDULER_TOKEN=
