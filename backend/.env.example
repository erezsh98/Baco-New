# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Database ---
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost/play_tennis

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Pelecard (credit-card gateway). Leave blank + DEV_MODE=true to bypass. ---
PELECARD_GATEWAY_URL=https://gateway.pelecard.biz/Iframe
PELECARD_MATNASIM_TERM=
PELECARD_MATNASIM_PASSWORD=
PELECARD_EVENYHUDA_TERM=
PELECARD_EVENYHUDA_PASSWORD=
PELECARD_KADIMATENNIS_TERM=
PELECARD_KADIMATENNIS_PASSWORD=
PELECARD_SHASHO_TERM=
PELECARD_SHASHO_PASSWORD=

# --- SMS (019sms). Optional; blank = no-op. ---
SMS_USERNAME=
SMS_PASSWORD=
SMS_GATEWAY_URL=https://www.019sms.co.il:8090/api

# ---------------------------------------------------------------------------
# E-MAIL (SMTP) — production uses Mailgun (same as the legacy system).
# Get credentials from Mailgun > Sending > Domains > <domain> > SMTP credentials:
#   SMTP_USER     = postmaster@<your-mailgun-domain>
#   SMTP_PASSWORD = the SMTP password shown for that domain
#   EMAIL_FROM    = the 'from' address (ideally on the verified domain)
# Blank credentials = email no-ops (the rest of the app still works).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=servicebaco@gmail.com

# Alternative — direct Gmail SMTP (needs 2-Step Verification + a 16-char App Password):
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USER=servicebaco@gmail.com / SMTP_PASSWORD=<app-password>
# Alternative — production-style local relay (Postfix -> Mailgun on the server):
#   SMTP_HOST=localhost / SMTP_PORT=25 / SMTP_USER= / SMTP_PASSWORD=

# --- URLs ---
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# --- Misc ---
ANTHROPIC_API_KEY=
# DEV_MODE=true bypasses the Pelecard gateway so card bookings auto-confirm.
DEV_MODE=true
